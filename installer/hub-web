    // annulerait le clic du bouton (et jouerait le titre sous le focus en même temps).
    if (aFocus() && (e.key === "Enter" || e.key === " ")) { e.preventDefault(); e.stopImmediatePropagation(); retour(); return; }
    // Une flèche ou Tab : on voulait le site, pas la pastille.
    if (aFocus() && e.key !== "Escape") cacher();
    if (e.key === "Escape" && !e.repeat) { echapDepuis = Date.now(); montrer(APPARITION_MS, true); }
    // Échap maintenue deux secondes : pour une télécommande sans F12.
