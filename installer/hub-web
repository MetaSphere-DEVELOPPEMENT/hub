# ── Ce qui se décide sans rien lancer ──────────────────────────────────────
def dossier(variable, defaut):
    return Path(os.environ.get(variable) or defaut)


def chemin_reglages():
    return dossier("XDG_CONFIG_HOME", Path.home() / ".config") / "hub" / "reglages.json"


def chemin_pid():
    return dossier("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}") / "hub" / "web.pid"


def service(identifiant):
    """La fiche d'un service de la liste blanche, ou None."""
    return SERVICES.get(identifiant) if isinstance(identifiant, str) else None


def lire_profil(chemin=None):
    """(identifiant du profil actif, langue). Un réglage illisible donne un profil
    « defaut » plutôt qu'un refus : on regarde YouTube sans session, pas un écran noir."""
    try:
        donnees = json.loads(Path(chemin or chemin_reglages()).read_text(encoding="utf-8"))
        actif = next(p for p in donnees["profils"] if p.get("id") == donnees.get("profilActif"))
    except (OSError, ValueError, KeyError, TypeError, StopIteration, AttributeError):
        return "defaut", "fr"
    ident = actif.get("id")
    langue = actif.get("langue") if actif.get("langue") in ("fr", "en") else "fr"
    return (ident if isinstance(ident, str) and PROFIL_VALIDE.match(ident) else "defaut"), langue


def dossier_profil(profil):
    """Un dossier de navigateur par profil du HUB : cookies, sessions Netflix et comptes
    Xbox d'un profil ne se voient pas depuis un autre."""
    if not isinstance(profil, str) or not PROFIL_VALIDE.match(profil):
        profil = "defaut"
    return dossier("XDG_DATA_HOME", Path.home() / ".local/share") / "hub" / "navigateur" / profil


def flatpak_installe(identifiant, racines=None):
    racines = racines if racines is not None else (
        Path.home() / ".local/share/flatpak/app", Path("/var/lib/flatpak/app"))
    return any((Path(r) / identifiant / "current").exists() for r in racines)


def commande_appli(fiche, which=shutil.which, flatpak=flatpak_installe):
    appli = fiche.get("appli") or {}
    if appli.get("commande") and which(appli["commande"][0]):
        return list(appli["commande"])
    if appli.get("flatpak") and which("flatpak") and flatpak(appli["flatpak"]):
        return ["flatpak", "run", appli["flatpak"]]
    return None


def trouver_navigateur(which=shutil.which):
    for nom in NAVIGATEURS:
        if which(nom):
            return nom
    return None


def disponibles(which=shutil.which, flatpak=flatpak_installe):
    """Ce que le menu peut proposer : une tuile sans navigateur ni appli ne lancerait rien."""
    navigateur = trouver_navigateur(which)
    services = {}
    for ident, fiche in SERVICES.items():
        appli = commande_appli(fiche, which, flatpak)
        via = "appli" if appli else "navigateur" if fiche.get("url") and navigateur else None
        services[ident] = {"disponible": via is not None, "via": via}
    return {"navigateur": navigateur, "services": services}


def url_locale(url):
    """--essai n'ouvre que du local : ce n'est pas une porte vers le web."""
    return isinstance(url, str) and bool(re.match(
        r"^(file:///|data:text/html|https?://(127\.0\.0\.1|localhost|\[::1\])(:\d+)?(/|$))", url))


def arguments_navigateur(navigateur, fiche, dossier_navigateur, langue="fr", essai=False, wayland=True):
    args = [
        navigateur,
        f"--user-data-dir={dossier_navigateur}",
        "--remote-debugging-pipe",
        "--no-first-run", "--no-default-browser-check",
        # Une session kiosque n'a pas de trousseau déverrouillé : sans ceci, Chrome ouvre
        # « Déverrouiller le trousseau » par-dessus Netflix, et on n'a pas de clavier.
        "--password-store=basic",
        "--hide-crash-restore-bubble", "--noerrdialogs",
        "--autoplay-policy=no-user-gesture-required",
        f"--lang={langue}",
        # Décodage vidéo par la puce Intel (VA-API) sous Wayland. Les noms ont changé au
        # fil des versions ; Chrome ignore ceux qu'il ne connaît pas. À vérifier sur la
        # machine dans chrome://gpu (« Video Decode: Hardware accelerated »).
        "--enable-features=AcceleratedVideoDecodeLinuxGL,AcceleratedVideoDecodeLinuxZeroCopyGL,"
        "VaapiVideoDecoder,VaapiIgnoreDriverChecks",
        "--disable-features=Translate,MediaRouter,HardwareMediaKeyHandling",
    ]
    if wayland:
        args.append("--ozone-platform=wayland")
    if fiche.get("agent"):
        args.append(f"--user-agent={fiche['agent']}")
    if essai:
        args += ["--window-size=640,360", "--new-window"]
    else:
        args.append("--kiosk")
    # La page vierge d'abord : le script de retour doit être en place AVANT que le
    # service ne charge, sinon la première page n'aurait pas de touche de retour.
    args.append("about:blank")
    return args


def script_injecte(fiche, langue="fr"):
    """Le JavaScript posé dans chaque page avant ses propres scripts.

    Il n'a qu'un canal vers ce programme, la fonction hubHub ajoutée par le protocole
    DevTools ; il ne sait rien faire d'autre que demander le retour ou une touche."""
    options = {"touches": bool(fiche.get("touches")), "sansAv1": bool(fiche.get("sans_av1")),
               "langue": langue if langue in ("fr", "en") else "fr"}
    return "(" + _JS + ")(" + json.dumps(options) + ");"


_JS = r"""function (options) {
  if (window.top !== window || window.__hubRetour) return;
  window.__hubRetour = true;
  const appeler = message => { try { window.hubHub(JSON.stringify(message)); } catch (e) { /* hors HUB */ } };
  const retour = () => appeler({ type: "retour" });

  if (options.sansAv1) {
    const av1 = type => /av01|av1/i.test(String(type || ""));
    const ms = window.MediaSource;
    if (ms && ms.isTypeSupported) {
      const original = ms.isTypeSupported.bind(ms);
      ms.isTypeSupported = type => !av1(type) && original(type);
    }
    const canPlay = HTMLMediaElement.prototype.canPlayType;
    HTMLMediaElement.prototype.canPlayType = function (type) { return av1(type) ? "" : canPlay.call(this, type); };
    const mc = navigator.mediaCapabilities;
    if (mc && mc.decodingInfo) {
      const decodage = mc.decodingInfo.bind(mc);
      mc.decodingInfo = config => av1(config && config.video && config.video.contentType)
        ? Promise.resolve({ supported: false, smooth: false, powerEfficient: false })
        : decodage(config);
    }
  }

  // ── Pastille « ← HUB » ──────────────────────────────────────────────────
  // Toutes les sorties ci-dessous sont invisibles : vu sur la TV le 17/09/2026, personne
  // ne devinait comment quitter Netflix. La pastille montre qu'une sortie existe, et
  // l'aide dit laquelle marche à la télécommande.
  // Ombre fermée : le CSS du site ne l'atteint pas, et ses scripts ne la trouvent pas
  // pour la cacher ou la cliquer à notre place.
  // Aucun HTML en texte ni <style> : YouTube impose les Trusted Types, et une CSP sans
  // 'unsafe-inline' refuserait la feuille ; une feuille construite et le CSSOM passent.
  const TEXTES = {
    fr: { nom: "Revenir au HUB", aide: "Maintenir Retour 2 s pour revenir au HUB" },
    en: { nom: "Back to the HUB", aide: "Hold Back for 2 s to return to the HUB" },
  };
  const texte = TEXTES[options.langue] || TEXTES.fr;
  const APPARITION_MS = 5000;
  // Valeurs de installer/menu/hub.css (--encre, --texte, --tv) : la même famille que le menu.
  // Taille en vh : 2,5 vh font 27 px à 1080p et restent lisibles à 3 m en 4K.
  const CSS = `
    .boite { display: flex; flex-direction: column; align-items: flex-start; gap: .5em;
      font: 600 max(14px, 2.5vh)/1.2 "Ubuntu Sans", "Inter", system-ui, sans-serif;
      color: #f3f5fb; opacity: 1; visibility: visible;
      transition: opacity 180ms cubic-bezier(.2, .8, .2, 1), visibility 0s; }
    .boite.cache { opacity: 0; visibility: hidden; transition: opacity 180ms cubic-bezier(.2, .8, .2, 1), visibility 0s 180ms; }
    .pastille { pointer-events: auto; display: inline-flex; align-items: center; gap: .45em;
      margin: 0; padding: .45em 1em .45em .8em; border: 0; border-radius: 999px;
      background: rgba(6, 7, 12, .74); color: inherit; font: inherit; letter-spacing: .04em;
      box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, .13), 0 .3em 1.4em rgba(0, 0, 0, .6);
      cursor: pointer; outline: none; -webkit-tap-highlight-color: transparent; }
    .fleche { color: rgb(62 224 208); font-weight: 700; }
    .pastille:focus, .pastille:hover { background: rgba(6, 7, 12, .9);
      box-shadow: inset 0 0 0 .12em rgb(62 224 208), 0 0 1.6em -.2em rgb(62 224 208 / .6); }
    .aide { font-size: .9em; font-weight: 500; padding: .4em .8em; border-radius: .6em;
      background: rgba(6, 7, 12, .74); color: #f3f5fb; pointer-events: none; }
    .aide[hidden] { display: none; }
    @media (prefers-reduced-motion: reduce) { .boite, .boite.cache { transition: none; } }`;

  const hote = document.createElement("hub-retour");
  const ombre = hote.attachShadow({ mode: "closed" });
  const boite = document.createElement("div");
  boite.className = "boite cache";
  const pastille = document.createElement("button");
  pastille.type = "button";
  pastille.className = "pastille";
  // Hors de l'ordre de tabulation : Tab reste au site ; seul Échap court y amène.
  pastille.tabIndex = -1;
  pastille.setAttribute("aria-label", texte.nom);
  const fleche = document.createElement("span");
  fleche.className = "fleche";
  fleche.setAttribute("aria-hidden", "true");
  fleche.textContent = "←";
  pastille.append(fleche, "HUB");
  const aide = document.createElement("div");
  aide.className = "aide";
  aide.hidden = true;
  aide.textContent = texte.aide;
  boite.append(pastille, aide);
  ombre.append(boite);
  try {
    const feuille = new CSSStyleSheet();
    feuille.replaceSync(CSS);
    ombre.adoptedStyleSheets = [feuille];
  } catch (e) {
    const style = document.createElement("style");
    style.textContent = CSS;
    ombre.prepend(style);
  }
  // Popover : la couche supérieure passe au-dessus d'un élément en plein écran, ce
  // qu'aucun z-index ne fait. Le z-index reste pour un Chrome sans popover.
  const popover = typeof hote.showPopover === "function";
  if (popover) hote.setAttribute("popover", "manual");
  // Styles de l'hôte en !important par le CSSOM : l'emportent sur le CSS du site sans
  // être soumis à sa CSP. Zone sûre TV : 5 % des bords.
  const styleHote = { position: "fixed", top: "5vh", left: "5vw", right: "auto", bottom: "auto", inset: "5vh auto auto 5vw",
    margin: "0", padding: "0", border: "0", background: "transparent", width: "auto", height: "auto",
    "max-width": "90vw", overflow: "visible", "z-index": "2147483647", "pointer-events": "none",
    opacity: "1", transform: "none", filter: "none", "color-scheme": "dark" };
  if (!popover) styleHote.display = "block";
  for (const [propriete, valeur] of Object.entries(styleHote)) hote.style.setProperty(propriete, valeur, "important");

  let minuterie = 0, enPause = false, precedent = null;
  const visible = () => !boite.classList.contains("cache");
  const aFocus = () => ombre.activeElement === pastille;
  // Un élément ajouté plus tard dans la couche supérieure passe devant : on s'y remet
  // chaque fois qu'on réapparaît, au cas où le site serait passé en plein écran entre-temps.
  const remonter = () => {
    if (!popover || !hote.isConnected) return;
    try {
      if (hote.matches(":popover-open")) {
        if (!document.fullscreenElement || aFocus()) return;
        hote.hidePopover();
      }
      hote.showPopover();
    } catch (e) { /* page qui vient de disparaître */ }
  };
  // Sous <html> et non <body> : les sites à page unique remplacent souvent tout le body.
  // En plein écran, dans l'élément plein écran : Chromium y dessine bien la couche
  // supérieure, mais rend le reste du document inerte (vu : pastille visible et clic
  // perdu). Une <video> mise elle-même en plein écran ne peut rien contenir : il reste
  // alors Échap maintenue, F12 et la manette.
  const parent = () => {
    const plein = document.fullscreenElement;
    return plein && !/^(VIDEO|IFRAME|IMG|CANVAS|OBJECT|EMBED)$/.test(plein.tagName) ? plein : document.documentElement;
  };
  const accrocher = () => {
    const cible = parent();
    if (cible && hote.parentNode !== cible && !(hote.isConnected && aFocus())) {
      cible.appendChild(hote);
      // Un popover déplacé est refermé.
      if (visible()) remonter();
    }
    return hote.isConnected;
  };
  const rendreFocus = () => {
    const cible = precedent;
    precedent = null;
    if (cible && cible !== hote && cible.isConnected && typeof cible.focus === "function") cible.focus({ preventScroll: true });
    if (aFocus()) pastille.blur();
  };
  const cacher = () => {
    if (aFocus()) rendreFocus();
    clearTimeout(minuterie);
    minuterie = 0;
    boite.classList.add("cache");
  };
  // duree 0 : reste affichée (vidéo en pause, pastille qui a le focus).
  const montrer = (duree, avecAide) => {
    if (!accrocher()) return;
    if (!visible()) { aide.hidden = !avecAide; remonter(); }
    else if (avecAide) aide.hidden = false;
    boite.classList.remove("cache");
    clearTimeout(minuterie);
    minuterie = duree ? setTimeout(() => { minuterie = 0; if (!aFocus() && !enPause) cacher(); }, duree) : 0;
  };
  const prendreFocus = () => {
    montrer(0, true);
    precedent = document.activeElement;
    pastille.focus({ preventScroll: true });
  };
  pastille.addEventListener("click", e => { e.preventDefault(); e.stopPropagation(); retour(); });
  pastille.addEventListener("blur", () => {
    if (visible() && !enPause && !minuterie) minuterie = setTimeout(() => { minuterie = 0; if (!aFocus() && !enPause) cacher(); }, APPARITION_MS);
  });

  // Une souris immobile reçoit des mouvements factices quand la page défile ou se
  // redessine sous elle (movementX et Y nuls) : sans ce filtre, la pastille surgirait en
  // pleine lecture. Pointeur verrouillé : un jeu en nuage, la souris est au jeu.
  const souris = { capture: true, passive: true };
  addEventListener("mousemove", e => { if ((e.movementX || e.movementY) && !document.pointerLockElement) montrer(APPARITION_MS); }, souris);
  addEventListener("pointerdown", () => { if (!document.pointerLockElement) montrer(APPARITION_MS); }, souris);
  addEventListener("touchstart", () => montrer(APPARITION_MS), souris);
  // Les événements de média ne remontent pas, mais la capture sur window les voit. Seule
  // une grande vidéo compte : les aperçus au survol de Netflix se mettent en pause sans cesse.
  const grandeVideo = v => {
    const r = v.getBoundingClientRect();
    return r.width >= innerWidth * .5 && r.height >= innerHeight * .5;
  };
  addEventListener("pause", e => {
    if (e.target instanceof HTMLVideoElement && !e.target.ended && grandeVideo(e.target)) { enPause = true; montrer(0); }
  }, true);
  addEventListener("play", e => {
    if (enPause && e.target instanceof HTMLVideoElement) { enPause = false; if (!aFocus()) cacher(); }
  }, true);
  document.addEventListener("fullscreenchange", () => { if (!aFocus() && !enPause) cacher(); accrocher(); }, true);
  const auChargement = () => { if (location.href !== "about:blank") montrer(APPARITION_MS); };
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", auChargement, { once: true });
  else auChargement();

  // Clavier : F12 comme dans Kodi. Écouté en capture sur window, avant la page.
  // Échap n'est jamais empêchée ni arrêtée : les sites s'en servent pour quitter leur
  // plein écran ou revenir en arrière. On l'observe seulement.
  let echapDepuis = 0, echapPriseParLeSite = false;
  addEventListener("keydown", e => {
    if (e.key === "F12") { e.preventDefault(); e.stopImmediatePropagation(); retour(); }
