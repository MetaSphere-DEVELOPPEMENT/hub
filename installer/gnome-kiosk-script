#!/bin/sh
# Session HUB — ~/.local/bin/gnome-kiosk-script, lancé par gnome-kiosk-script-session.
#
# Une seule boucle : afficher le menu, lancer le mode choisi, puis revenir au menu
# quand ce mode se termine. C'est le motif de l'exemple fourni par GNOME (« exec "$0" »
# après le programme) : le retour au HUB est la fin normale d'un mode, pas un
# mécanisme à part.

# ── Le menu qui ne démarre pas ──────────────────────────────────────────────
# Un menu mort sans rien choisir (page cassée, Python en erreur) était relancé chaque
# seconde : écran noir qui clignote, et rien pour le dire. On attend de plus en plus
# longtemps (1, 2, 4, 8, 16, puis 30 s) et, dès le deuxième échec de suite, l'écran
# d'attente le dit avec le compte à rebours. Un menu qui se ferme normalement — un mode
# choisi, ou sa relance après une mise à jour — remet le compteur à zéro.
COMPTEUR_ECHECS="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hub/menu-echecs"
delai_apres_echecs() { # nombre d'échecs de suite → secondes
  case "$1" in 1) echo 1 ;; 2) echo 2 ;; 3) echo 4 ;; 4) echo 8 ;; 5) echo 16 ;; *) echo 30 ;; esac
}
attendre_apres_echec() { # fichier_compteur code_de_sortie
  n=$(tr -cd '0-9' <"$1" 2>/dev/null); n=$(( ${n:-0} + 1 ))
  mkdir -p "$(dirname "$1")" && printf '%s\n' "$n" >"$1"
  delai=$(delai_apres_echecs "$n")
  echo "gnome-kiosk-script : le menu s'est arrêté (code $2), échec $n de suite, nouvel essai dans $delai s" >&2
  ecran=
  if [ "$n" -ge 2 ] && [ -x /usr/local/bin/hub-transition ]; then
    setsid /usr/local/bin/hub-transition --secours "$delai" >/dev/null 2>&1 &
    ecran=$!
  fi
  sleep "$delai"
  [ -n "$ecran" ] && kill "$ecran" 2>/dev/null
  return 0
}

# Le menu écrit le mode sur sa première ligne et, pour « Continuer à regarder », le
# fichier à reprendre sur la seconde. Deux lignes plutôt qu'un format à analyser :
# un script de session doit se lire d'un coup d'œil un soir de panne.
sortie=$(/usr/local/bin/hub-menu)
code=$?
if [ -z "$sortie" ] && [ "$code" -ne 0 ]; then
  attendre_apres_echec "$COMPTEUR_ECHECS" "$code"
  exec "$0" "$@"
fi
rm -f "$COMPTEUR_ECHECS"
choix=$(printf '%s\n' "$sortie" | sed -n 1p)
fichier=$(printf '%s\n' "$sortie" | sed -n 2p)

# Habiller Kodi, le bureau ou les jeux aux couleurs du profil, sauf si l'utilisateur a
# choisi l'apparence d'origine dans le menu. Jamais bloquant : un thème raté ne doit
# pas priver de TV, d'où l'absence de « && » et la sortie jetée.
habiller() {
  [ -e "$HOME/.config/hub/habillage-desactive" ] || /usr/local/bin/hub-theme "$1" >/dev/null 2>&1
}

# Temps d'écran : chaque mode tourne À TRAVERS hub-temps-ecran, qui l'attend comme
# cette boucle le ferait, compte sa durée pour le profil actif, prévient cinq minutes
# avant la fin et le ferme à l'échéance (retour au menu). Absent (installation
# ancienne) : le mode se lance tel quel, on ne prive personne de TV pour un compteur.
compter() {
  mode="$1"; shift
  if [ -x /usr/local/bin/hub-temps-ecran ]; then
    /usr/local/bin/hub-temps-ecran lancer "$mode" -- "$@"
  else
    "$@"
  fi
}

case "$choix" in
  tv)
    # Avant Kodi, jamais pendant : Kodi réécrit ses réglages en quittant (hub-theme
    # refuse d'ailleurs, code 3, s'il tourne déjà).
    habiller tv
    # Kodi dans la session kiosque, en client Wayland : le compositeur le met en
    # plein écran. Quitter Kodi rend la main à cette boucle.
    if [ -n "$fichier" ]; then
      # hub-kodi-lire lance Kodi lui-même et attend qu'il se ferme : pour cette
      # boucle, c'est comme avoir lancé Kodi.
      compter tv /usr/local/bin/hub-kodi-lire "$fichier"
    else
      compter tv kodi --windowing=wayland
    fi
    ;;
  gaming)
    # Pas encore configuré : la source du streaming n'est pas décidée. Quand un client
    # existera, il lira l'accent du profil dans cet environnement (Moonlight-qt).
    habiller jeux
    [ -f "$HOME/.config/hub/jeux.env" ] && { set -a; . "$HOME/.config/hub/jeux.env"; set +a; }
    ;;
  web)
    # Streaming ou jeu en nuage : la seconde ligne est un NOM de service (« netflix »),
    # jamais une adresse. hub-web le refuse s'il n'est pas dans sa liste blanche, ouvre
    # le navigateur du profil en plein écran et rend la main quand on revient au HUB.
    compter web /usr/local/bin/hub-web "$fichier"
    ;;
  bureau)
    # Le bureau GNOME ne se lance pas à l'intérieur d'une session kiosque. On
    # choisit la session Ubuntu pour la prochaine connexion et on ferme celle-ci ;
    # à la sortie du bureau, la connexion automatique ramène au HUB.
    /usr/local/bin/hub-vers-bureau
    ;;
  eteindre)
    systemctl poweroff
    ;;
  redemarrer)
    # Même chemin que l'extinction : le menu a déjà demandé confirmation, et logind
    # l'autorise à la session locale active. La boucle ne reprend pas la main.
    systemctl reboot
    ;;
esac

sleep 1
exec "$0" "$@"
