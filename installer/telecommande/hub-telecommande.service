# Télécommande téléphone du HUB — unité UTILISATEUR.
#
# Pourquoi une unité utilisateur : les commandes vont au menu, à Kodi, à PipeWire
# (wpctl) et à gnome-session-quit, qui vivent tous dans la session de l'utilisateur
# (XDG_RUNTIME_DIR, bus D-Bus de session). Un service système n'y aurait pas accès
# sans bricolage.
#
# Pourquoi graphical-session.target : la session kiosque du HUB comme le bureau GNOME
# l'atteignent, donc la télécommande démarre dans les deux.
#
# Pourquoi PAS PartOf=graphical-session.target (retiré le 18 septembre 2026). Le mode
# Bureau n'est pas une fenêtre de plus : hub-vers-bureau ferme la session kiosque et
# GDM rouvre aussitôt la session Ubuntu. Avec PartOf, systemd arrêtait la télécommande
# à ce moment-là — le téléphone perdait la main en entrant dans un mode, exactement
# quand il sert le plus, et n'avait aucun moyen de savoir quand le service revenait.
# Sans PartOf, le service traverse le changement de session : même adresse, même port,
# même jeton, rien à retaper. Il s'arrête quand le gestionnaire utilisateur s'arrête,
# c'est-à-dire à l'extinction — et il efface alors son fichier d'état.
#
# Restart=always et non on-failure : un service tombé pendant un film doit revenir
# seul, même après une sortie propre imprévue (ligne de commande, signal).
#
# Souris et clavier (hub_pointeur.py) : le service ouvre /dev/uinput grâce au groupe
# hub-uinput posé par l'installateur (règle udev 71-hub-uinput.rules), rien de plus.
# PAS de PrivateDevices ni de DeviceAllow ici : dans une unité utilisateur ils sont sans
# effet ou font échouer le démarrage — et cette unité est le seul moyen de piloter le
# HUB depuis le canapé : aucune option qu'on n'a pas pu éprouver sur la TV n'y entre.
#
# Le réseau n'est pas une dépendance : les unités utilisateur ne voient pas
# network-online.target. Le programme attend lui-même une adresse, et rouvre
# l'écoute si elle change.

[Unit]
Description=HUB : télécommande téléphone (page web sur le réseau local, port 8790)
Documentation=file:///usr/local/lib/hub/telecommande/README.md
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/hub/telecommande/hub_telecommande.py
Restart=always
RestartSec=2
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=graphical-session.target
