// Autorise l'utilisateur du HUB (groupe « hub ») à réarmer l'allumage programmé, et
// seulement cela : démarrer hub-allumage.service, qui ne fait que relire ses horaires.
polkit.addRule(function (action, subject) {
  if (action.id === "org.freedesktop.systemd1.manage-units" &&
      action.lookup("unit") === "hub-allumage.service" &&
      action.lookup("verb") === "start" &&
      subject.isInGroup("hub")) {
    return polkit.Result.YES;
  }
});
