# ── Bureau : gsettings ────────────────────────────────────────────────────
def formater_gvariant(valeur):
    if isinstance(valeur, bool):
        return "true" if valeur else "false"
    if isinstance(valeur, (int, float)):
        return repr(valeur)
    return "'" + str(valeur).replace("\\", "\\\\").replace("'", "\\'") + "'"


def lire_gvariant(texte):
    """Le peu de GVariant texte que rendent les clés touchées ici : chaîne, booléen, nombre."""
    texte = texte.strip()
    for prefixe in ("uint32 ", "int32 ", "uint64 ", "int64 ", "byte "):
        if texte.startswith(prefixe):
            texte = texte[len(prefixe):]
    if texte in ("true", "false"):
        return texte == "true"
    if len(texte) >= 2 and texte[0] == texte[-1] and texte[0] in "'\"":
        sortie, i = [], 1
        while i < len(texte) - 1:
            if texte[i] == "\\" and i + 1 < len(texte) - 1:
                i += 1
            sortie.append(texte[i])
            i += 1
        return "".join(sortie)
    for conversion in (int, float):
        try:
            return conversion(texte)
        except ValueError:
            pass
    return texte


def egales(a, b):
    if isinstance(a, float) or isinstance(b, float):
        try:
            return math.isclose(float(a), float(b), abs_tol=1e-6)
        except (TypeError, ValueError):
            return False
    return type(a) is type(b) and a == b


def executer_systeme(argv):
    try:
        r = subprocess.run(argv, capture_output=True, text=True, timeout=10)
        return r.returncode, r.stdout
    except (OSError, subprocess.SubprocessError):
        return 127, ""


def valeurs_bureau(apparence, accent, yaru):
    sombre = apparence.theme == "sombre"
    i, fond, verrou, dock = ("org.gnome.desktop.interface", "org.gnome.desktop.background",
                             "org.gnome.desktop.screensaver", "org.gnome.shell.extensions.dash-to-dock")
    valeurs = {(i, "color-scheme"): "prefer-dark" if sombre else "default"}
    if accent:
        valeurs[(i, "accent-color")] = accent
    if yaru:
        valeurs[(i, "gtk-theme")] = yaru
        valeurs[(i, "icon-theme")] = yaru
    options = "zoom"
    valeurs.update({
        (fond, "picture-uri"): apparence.fond_uri,
        # GNOME prend picture-uri-dark en mode sombre : sans elle, le fond ne suivrait
        # le profil qu'une moitié de la journée.
        (fond, "picture-uri-dark"): apparence.fond_uri,
        (fond, "picture-options"): options,
        # Couleur affichée le temps que l'image se charge : celle du fond, pas le bleu d'Ubuntu.
        (fond, "primary-color"): apparence.base,
        (verrou, "picture-uri"): apparence.fond_uri,
        (verrou, "picture-options"): options,
        (verrou, "primary-color"): apparence.base,
        # Dock d'Ubuntu : la teinte du fond HUB en verre fumé, pour que le dock appartienne
        # au décor au lieu d'y poser la barre grise d'Ubuntu.
        (dock, "transparency-mode"): "FIXED",
        (dock, "custom-background-color"): True,
        (dock, "background-color"): apparence.base,
        (dock, "background-opacity"): 0.6 if sombre else 0.7,
    })
    return valeurs


def cle_texte(cle):
    return f"{cle[0]} {cle[1]}"


def lire_cles(executer, cles):
    """Valeurs actuelles, en texte GVariant. Une clé illisible (schéma absent — dock
    désinstallé, GNOME trop ancien pour accent-color) est omise, donc jamais écrite."""
    actuelles = {}
    for schema, cle in cles:
        code, sortie = executer(["gsettings", "get", schema, cle])
        if code == 0:
            actuelles[(schema, cle)] = sortie.strip()
    return actuelles


def commandes_gsettings(voulues, actuelles):
    return [["gsettings", "set", schema, cle, formater_gvariant(valeur)]
            for (schema, cle), valeur in voulues.items()
            if (schema, cle) in actuelles and not egales(lire_gvariant(actuelles[(schema, cle)]), valeur)]


def accents_permis(executer):
    code, sortie = executer(["gsettings", "range", "org.gnome.desktop.interface", "accent-color"])
    lignes = sortie.split()
    if code != 0 or not lignes or lignes[0] != "enum":
        return None
    return {lire_gvariant(l) for l in lignes[1:]}


def appliquer_bureau(apparence, executer, chemin_origine, yaru_dispo=None, sauvegarder=True):
    sombre = apparence.theme == "sombre"
    accent = accent_gnome(apparence.couleur, accents_permis(executer))
    yaru = variante_yaru(apparence.couleur, sombre, variantes_yaru() if yaru_dispo is None else yaru_dispo)
    voulues = valeurs_bureau(apparence, accent, yaru)
    actuelles = lire_cles(executer, voulues)
    commandes = commandes_gsettings(voulues, actuelles)

    if commandes and sauvegarder:
        # La sauvegarde précède l'écriture et ne retient que la première valeur jamais vue :
        # au second passage, la valeur actuelle est celle du HUB, pas celle de l'utilisateur.
        origine = lire_json(chemin_origine) or {}
        nouvelles = {cle_texte((c[2], c[3])): actuelles[(c[2], c[3])] for c in commandes
                     if cle_texte((c[2], c[3])) not in origine}
        if nouvelles:
            origine.update(nouvelles)
            ecrire_atomique(chemin_origine, json.dumps(origine, indent=2, ensure_ascii=False))
    erreurs = [c for c in commandes if executer(c)[0] != 0]
    return {"accent": accent, "yaru": yaru,
            "ecrites": [cle_texte((c[2], c[3])) for c in commandes if c not in erreurs],
            "erreurs": [cle_texte((c[2], c[3])) for c in erreurs]}


def restaurer_bureau(executer, chemin_origine):
    origine = lire_json(chemin_origine)
    if not isinstance(origine, dict):
        return {"restaurees": []}
    cles = [tuple(k.split(" ", 1)) for k in origine]
    actuelles = lire_cles(executer, cles)
    restaurees = []
    for cle in cles:
        brut = origine[cle_texte(cle)]
        if cle in actuelles and not egales(lire_gvariant(actuelles[cle]), lire_gvariant(brut)):
            if executer(["gsettings", "set", cle[0], cle[1], brut])[0] == 0:
                restaurees.append(cle_texte(cle))
    Path(chemin_origine).unlink(missing_ok=True)
    return {"restaurees": restaurees}


# ── Kodi ──────────────────────────────────────────────────────────────────
def kodi_tourne(proc=Path("/proc")):
    try:
        entrees = list(Path(proc).iterdir())
    except OSError:
        return False
    for e in entrees:
        if not e.name.isdigit():
            continue
        try:
            if (e / "comm").read_text().strip() in PROCESSUS_KODI:
                return True
        except OSError:
            continue
    return False


def regler_xml(chemin, valeurs, version="2", type_=None):
    """Poser des <setting id=…> sans toucher aux autres ; True si le fichier a changé.

    Même principe que installer/kodi/regler-guisettings.py : ces fichiers portent les
    réglages que l'utilisateur a faits devant la TV. Un fichier illisible n'est pas
    remplacé : mieux vaut un thème non appliqué qu'un Kodi remis à zéro."""
    chemin = Path(chemin)
    if chemin.exists():
        try:
            arbre = ET.parse(chemin)
        except ET.ParseError as e:
            raise ErreurTheme(f"{chemin} illisible, laissé tel quel : {e}")
        racine = arbre.getroot()
    else:
        racine = ET.Element("settings", version=version)
        arbre = ET.ElementTree(racine)
    existants = {e.get("id"): e for e in racine.iter("setting")}
    change = False
    for cle, valeur in valeurs.items():
        element = existants.get(cle)
        if element is not None and (element.text or "") == valeur:
            continue
        if element is None:
            element = ET.SubElement(racine, "setting", id=cle)
            if type_:
                element.set("type", type_)
        element.text = valeur
        # Kodi marque default="true" les valeurs par défaut ; le laisser ferait passer
        # notre choix pour un défaut, que Kodi peut réécrire.
        element.attrib.pop("default", None)
        change = True
    if change:
        ET.indent(arbre, space="    ")
        provisoire = chemin.with_name(chemin.name + ".hub-tmp")
        chemin.parent.mkdir(parents=True, exist_ok=True)
        arbre.write(provisoire, encoding="utf-8", xml_declaration=True)
        os.replace(provisoire, chemin)
    return change


def lier(cible, lien):
    try:
        lien.symlink_to(cible)
    except OSError:
        shutil.copyfile(lien.parent / cible if not Path(cible).is_absolute() else cible, lien)


def preparer_fonds_kodi(apparence, dossier_kodi, taille):
    """Un dossier dont chaque entrée de l'accueil a son image, nommé par l'empreinte du
    contenu. Kodi garde en cache une texture par chemin (Textures13.db) et ne revérifie
    les fichiers locaux que rarement : réécrire la même adresse montrerait l'ancien fond."""
    if apparence.photo:
        photo = Path(apparence.photo)
        etat = photo.stat()
        cle = empreinte("photo", str(photo), etat.st_mtime_ns, etat.st_size)
        extension = photo.suffix.lower()
    else:
        cle = empreinte(apparence.fond, "sombre", apparence.couleur, taille)
        extension = ".png"
    dossier = Path(dossier_kodi) / cle
    if not dossier.is_dir():
        provisoire = Path(tempfile.mkdtemp(prefix=".hub-", dir=_creer(dossier_kodi)))
        if apparence.photo:
            source = Path(apparence.photo).resolve()
        else:
            source = Path("fond.png")
            # Toujours la version sombre : Estuary n'a pas de thème clair, et il pose le
            # fond à 19 % d'opacité (bg_overlay = 30FFFFFF) sur sa couleur de base. Un
            # fond clair y deviendrait un voile gris.
            ecrire_png(provisoire / source, *rendre_fond(apparence.fond, "sombre", apparence.couleur, *taille))
        for entree in ENTREES_ACCUEIL_ESTUARY:
            lier(source, provisoire / f"{entree}{extension}")
        os.replace(provisoire, dossier)
    for autre in Path(dossier_kodi).iterdir():
        if autre != dossier and autre.is_dir():
            shutil.rmtree(autre, ignore_errors=True)
    return dossier, extension


def _creer(dossier):
    Path(dossier).mkdir(parents=True, exist_ok=True)
    return dossier


def appliquer_tv(apparence, c, tourne=kodi_tourne, skins=None, taille=(960, 540)):
    """taille : Estuary dessine en 1080p et étire les fonds ; 960×540 tramé suffit à un
    dégradé sans détail, et se calcule en quelques secondes en Python pur."""
    if tourne():
        # Kodi réécrit guisettings.xml et les réglages du skin en quittant : écrire
        # maintenant serait effacé, ou pire, mélangé.
        raise KodiOuvert("Kodi est ouvert : réglages non modifiés (relancer après sa fermeture)")
    table = couleurs_estuary(skins)
    couleur = couleur_estuary(apparence.couleur, table)
    resume = {"skincolors": None, "fond_accueil": None}

    skin_actuel = None
    if c["guisettings"].exists():
        try:
            skin_actuel = next((e.text for e in ET.parse(c["guisettings"]).getroot().iter("setting")
                                if e.get("id") == "lookandfeel.skin"), None)
        except ET.ParseError as e:
            raise ErreurTheme(f"{c['guisettings']} illisible, laissé tel quel : {e}")
    # Les noms de couleurs sont ceux d'Estuary : sur un autre skin ils ne veulent rien dire.
    if skin_actuel in (None, "skin.estuary"):
        regler_xml(c["guisettings"], {"lookandfeel.skincolors": couleur})
        resume["skincolors"] = couleur

    dossier, extension = preparer_fonds_kodi(apparence, c["fonds"] / "kodi", taille)
    regler_xml(c["skin_estuary"], {
        "HomeFanart.path": str(dossier) + "/",
        "HomeFanart.ext": extension,
        "HomeFanart.name": "HUB",
    }, version="1", type_="string")
    resume["fond_accueil"] = str(dossier)
    return resume


