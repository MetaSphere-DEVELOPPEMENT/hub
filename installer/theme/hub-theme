def _distance_segment(px, py, ax, ay, bx, by):
    dx, dy = bx - ax, by - ay
    t = max(0, min(1, ((px - ax) * dx + (py - ay) * dy) / (dx * dx + dy * dy or 1)))
    return math.hypot(px - (ax + t * dx), py - (ay + t * dy))


def _distance_arc(px, py, cx, cy, r, cote):
    """Demi-cercle : « bas » (y ≥ cy) ou « droite » (x ≥ cx). Hors du demi-plan, la
    distance aux extrémités, pour que le trait se raccorde aux segments."""
    dedans = py >= cy if cote == "bas" else px >= cx
    if dedans:
        return abs(math.hypot(px - cx, py - cy) - r)
    bouts = [(cx - r, cy), (cx + r, cy)] if cote == "bas" else [(cx, cy - r), (cx, cy + r)]
    return min(math.hypot(px - x, py - y) for x, y in bouts)


# Les trois lettres en traits (unités : hauteur de lettre = 1). Dessinées ici plutôt que
# rendues avec une police : Plymouth tourne dans l'initramfs, où le greffon de texte
# et les polices ne sont pas garantis. Une image, elle, s'affiche toujours.
LETTRES = [
    [("s", 0, 0, 0, 1), ("s", .7, 0, .7, 1), ("s", 0, .5, .7, .5)],
    [("s", 0, 0, 0, .65), ("s", .7, 0, .7, .65), ("a", .35, .65, .35, "bas")],
    [("s", 0, 0, 0, 1), ("s", 0, 0, .33, 0), ("s", 0, .47, .38, .47), ("s", 0, 1, .38, 1),
     ("a", .33, .235, .235, "droite"), ("a", .38, .735, .265, "droite")],
]


def image_mot_hub(hauteur_lettre=96, couleur=(240, 242, 248)):
    epaisseur, avance, marge = .15, 1.05, .15
    largeur = int((marge * 2 + avance * 2 + .7) * hauteur_lettre) + 1
    hauteur = int((marge * 2 + 1) * hauteur_lettre) + 1
    lignes = []
    for y in range(hauteur):
        ligne = bytearray(largeur * 4)
        v = (y + .5) / hauteur_lettre - marge
        for x in range(largeur):
            u = (x + .5) / hauteur_lettre - marge
            d = 9.0
            for i, traits in enumerate(LETTRES):
                lu = u - i * avance
                if -.3 < lu < 1:
                    for t in traits:
                        if t[0] == "s":
                            d = min(d, _distance_segment(lu, v, *t[1:]))
                        else:
                            d = min(d, _distance_arc(lu, v, *t[1:]))
            # Couverture d'un pixel : bord adouci sur un pixel de large.
            couverture = max(0.0, min(1.0, (epaisseur / 2 - d) * hauteur_lettre + .5))
            ligne[x * 4:x * 4 + 4] = bytes((*couleur, round(255 * couverture)))
        lignes.append(ligne)
    return largeur, hauteur, lignes


def image_point(diametre, couleur):
    lignes = []
    r = diametre / 2
    for y in range(diametre):
        ligne = bytearray(diametre * 4)
        for x in range(diametre):
            couverture = max(0.0, min(1.0, r - math.hypot(x + .5 - r, y + .5 - r)))
            ligne[x * 4:x * 4 + 4] = bytes((*couleur, round(255 * couverture)))
        lignes.append(ligne)
    return diametre, diametre, lignes


