    def flottants(rvb):
        return ", ".join(f"{c / 255:.3f}" for c in rvb)
    ar, av, ab = (f"{c / 255:.3f}" for c in apparence.couleur)
    ecrire_atomique(dossier / "hub.plymouth", PLYMOUTH_INI)
    ecrire_atomique(dossier / "hub.script", SCRIPT_PLYMOUTH.format(
        haut=flottants(base), bas=flottants(bas), ar=ar, av=av, ab=ab,
        logo=PLYMOUTH_LOGO, point=PLYMOUTH_POINT, message=PLYMOUTH_MESSAGE))
    largeur, hauteur, lignes = image_mot_hub(round(HAUTEUR_ECRAN_4K * PLYMOUTH_LOGO / (1 + 2 * .15)))
    ecrire_png(dossier / "hub.png", largeur, hauteur, lignes)
    ecrire_png(dossier / "point.png", *image_point(round(HAUTEUR_ECRAN_4K * PLYMOUTH_POINT), apparence.couleur))
    return {"dossier": str(dossier), "fichiers": ["hub.plymouth", "hub.script", "hub.png", "point.png"]}


# ── Ligne de commande ─────────────────────────────────────────────────────
def executer_simule(argv):
    """--simuler : les lectures sont réelles (elles ne changent rien), les écritures
    sont affichées au lieu d'être faites."""
    if argv[:2] == ["gsettings", "set"]:
        print("simulé :", " ".join(argv), file=sys.stderr)
        return 0, ""
    return executer_systeme(argv)


def main(arguments=None):
    analyseur = argparse.ArgumentParser(prog="hub-theme", description=__doc__.split("\n")[0])
    analyseur.add_argument("commande", choices=["bureau", "tv", "jeux", "apercu", "etat", "restaurer", "plymouth"])
    analyseur.add_argument("dossier", nargs="?", help="plymouth : dossier où écrire le thème")
    analyseur.add_argument("--theme", choices=THEMES, help="forcer sombre ou clair (sinon celui du profil)")
    analyseur.add_argument("--profil", help="identifiant du profil (sinon le profil actif)")
    analyseur.add_argument("--simuler", action="store_true", help="bureau/restaurer : afficher sans écrire")
    options = analyseur.parse_args(arguments)

    c = chemins(Path.home(), os.environ)
    executer = executer_simule if options.simuler else executer_systeme
    try:
        if options.commande == "restaurer":
            resume = restaurer_bureau(executer, c["origine"])
        else:
            profil = profil_actif(lire_json(c["reglages"]), options.profil)
            theme = resoudre_theme(profil, options.theme, meteo=lire_json(c["meteo"]))
            commande = options.commande
            # etat n'écrit rien ; apercu écrit dans un dossier à part, pour ne jamais
            # effacer le fond qu'utilise le bureau en ce moment.
            apparence = construire_apparence(
                profil, theme, c, generer=commande != "etat",
                dossier_fonds=c["fonds"] / "apercu" if commande == "apercu" else None)
            resume = {"profil": profil.get("id"), "theme": theme, "couleur": rvb_hex(apparence.couleur),
                      "fond": apparence.fond, "fond_uri": apparence.fond_uri}
            if commande == "bureau":
                resume.update(appliquer_bureau(apparence, executer, c["origine"], sauvegarder=not options.simuler))
            elif commande == "tv":
                resume.update(appliquer_tv(apparence, c))
            elif commande == "jeux":
                resume.update(appliquer_jeux(apparence, c))
            elif commande == "etat":
                resume.update({
                    "accent_gnome": accent_gnome(apparence.couleur, accents_permis(executer_systeme)),
                    "yaru": variante_yaru(apparence.couleur, theme == "sombre", variantes_yaru()),
                    "estuary": couleur_estuary(apparence.couleur, couleurs_estuary()),
                    "kodi_ouvert": kodi_tourne(),
                    "jeux": presence_jeux(c["maison"]),
                })
            elif commande == "plymouth":
                if not options.dossier:
                    analyseur.error("plymouth demande un DOSSIER")
                resume.update(generer_plymouth(options.dossier, apparence))
    except KodiOuvert as e:
        print(f"hub-theme : {e}", file=sys.stderr)
        return 3
    except (ErreurTheme, OSError) as e:
        print(f"hub-theme : {e}", file=sys.stderr)
        return 1
    print(json.dumps(resume, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main())
