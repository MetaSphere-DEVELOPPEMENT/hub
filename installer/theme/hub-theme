# ── Couleurs ──────────────────────────────────────────────────────────────
def hex_rvb(texte):
    texte = texte.lstrip("#")
    return tuple(int(texte[i:i + 2], 16) for i in (0, 2, 4))


def rvb_hex(rvb):
    return "#" + "".join(f"{max(0, min(255, round(c))):02x}" for c in rvb)


def melange(a, b, t):
    return tuple(x + (y - x) * t for x, y in zip(a, b))


def oklab(rvb):
    def lineaire(c):
        c /= 255
        return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4
    r, g, b = (lineaire(c) for c in rvb)
    l = (0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b) ** (1 / 3)
    m = (0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b) ** (1 / 3)
    s = (0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b) ** (1 / 3)
    return (0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
            1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
            0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s)


def distance(a, b):
    """Distance perçue (OKLab), clarté comptée au tiers.

    Les couleurs de profil sont des pastels lumineux faits pour un fond noir ; les
    accents de GNOME, de Yaru et d'Estuary sont des teintes moyennes faites pour du
    texte blanc. L'écart de clarté est donc systématique et ne dit rien de la teinte
    voulue : compté en entier, il envoie le violet du HUB vers le bleu d'Adwaita. À la
    moitié, le turquoise part encore vers le vert menthe d'Estuary plutôt que vers son
    « teal ». Au tiers, les trois tables (GNOME, Yaru, Estuary) donnent pour chaque
    couleur de profil la teinte qu'on nommerait à l'œil ; en dessous (un quart), le
    corail bascule du orange au rouge sur GNOME."""
    la, lb = oklab(a), oklab(b)
    return (0.35 * (la[0] - lb[0])) ** 2 + (la[1] - lb[1]) ** 2 + (la[2] - lb[2]) ** 2


def plus_proche(rvb, candidats):
    """candidats : {nom: (r, v, b)}. None s'il n'y en a aucun."""
    if not candidats:
        return None
    return min(candidats, key=lambda nom: (distance(rvb, candidats[nom]), nom))


def accent_gnome(rvb, permis=None):
    candidats = {n: hex_rvb(h) for n, h in ACCENTS_GNOME.items() if permis is None or n in permis}
    return plus_proche(rvb, candidats)


def variante_yaru(rvb, sombre, disponibles):
    """Nom de thème Yaru (GTK et icônes) le plus proche, parmi ceux présents sur le disque."""
    def nom(base):
        if not sombre:
            return base
        return "Yaru-dark" if base == "Yaru" else base + "-dark"
    candidats = {nom(b): hex_rvb(h) for b, h in ACCENTS_YARU.items() if nom(b) in disponibles}
    return plus_proche(rvb, candidats)


def variantes_yaru(dossiers_themes=None, dossiers_icones=None):
    """Variantes utilisables : un thème GTK 3 ET un jeu d'icônes du même nom."""
    maison = Path.home()
    if dossiers_themes is None:
        dossiers_themes = [Path("/usr/share/themes"), maison / ".local/share/themes", maison / ".themes"]
    if dossiers_icones is None:
        dossiers_icones = [Path("/usr/share/icons"), maison / ".local/share/icons", maison / ".icons"]

    def noms(dossiers, fichier):
        trouves = set()
        for d in dossiers:
            try:
                for e in Path(d).iterdir():
                    if e.name.startswith("Yaru") and (e / fichier).exists():
                        trouves.add(e.name)
            except OSError:
                pass
        return trouves
    return noms(dossiers_themes, "gtk-3.0") & noms(dossiers_icones, "index.theme")


def couleurs_estuary(skins=None):
    """{valeur de lookandfeel.skincolors: button_focus} lue dans le skin installé."""
    for skin in (SKINS_ESTUARY if skins is None else skins):
        table = {}
        try:
            fichiers = sorted((Path(skin) / "colors").glob("*.xml"))
        except OSError:
            continue
        for f in fichiers:
            try:
                for c in ET.parse(f).getroot().iter("color"):
                    if c.get("name") == "button_focus" and c.text and len(c.text.strip()) == 8:
                        nom = "SKINDEFAULT" if f.stem == "defaults" else f.stem
                        table[nom] = hex_rvb(c.text.strip()[2:])
            except (ET.ParseError, OSError, ValueError):
                continue
        if table:
            return table
    return dict(ESTUARY_KODI_21)


def couleur_estuary(rvb, table=None):
    return plus_proche(rvb, table or ESTUARY_KODI_21)


# ── Réglages du HUB ───────────────────────────────────────────────────────
def chemins(maison=None, env=None):
    maison = Path(maison or Path.home())
    env = env or {}

    def xdg(variable, defaut):
        return Path(env.get(variable) or maison / defaut)
    config, donnees = xdg("XDG_CONFIG_HOME", ".config"), xdg("XDG_DATA_HOME", ".local/share")
    etat, cache = xdg("XDG_STATE_HOME", ".local/state"), xdg("XDG_CACHE_HOME", ".cache")
    kodi = Path(env.get("KODI_DATA") or maison / ".kodi")
    return {
        "maison": maison,
        "reglages": config / "hub" / "reglages.json",
        "meteo": cache / "hub" / "meteo.json",
        "fonds": donnees / "hub" / "fonds",
        "origine": etat / "hub" / "theme-origine.json",
        "jeux_env": config / "hub" / "jeux.env",
        "guisettings": kodi / "userdata" / "guisettings.xml",
        "skin_estuary": kodi / "userdata" / "addon_data" / "skin.estuary" / "settings.xml",
    }


def lire_json(chemin):
    try:
        return json.loads(Path(chemin).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None


def profil_actif(reglages, identifiant=None):
    profils = reglages.get("profils") if isinstance(reglages, dict) else None
    profils = [p for p in profils if isinstance(p, dict)] if isinstance(profils, list) else []
    voulu = identifiant or (reglages or {}).get("profilActif") if isinstance(reglages, dict) else identifiant
    choisi = next((p for p in profils if p.get("id") == voulu), profils[0] if profils else {})
    return {**DEFAUTS_PROFIL, **choisi}


def resoudre_theme(profil, force=None, maintenant=None, meteo=None):
    """Même règle que themeEffectif() du menu : le soleil du jour s'il est connu, sinon
    8 h–20 h. Le menu et le bureau ne doivent pas se contredire à la même minute."""
    if force in THEMES:
        return force
    choix = profil.get("theme")
    if choix in THEMES:
        return choix
    if choix != "auto":
        return "sombre"
    maintenant = maintenant or datetime.datetime.now()
    jour = ((meteo or {}).get("donnees") or {}).get("daily") or {}
    aujourdhui = maintenant.date().isoformat()
    try:
        levers, couchers = jour.get("sunrise") or [], jour.get("sunset") or []
        # Le cache peut dater de plusieurs jours : on ne prend que la ligne d'aujourd'hui.
        i = next(i for i, l in enumerate(levers) if str(l).startswith(aujourdhui))
        lever = datetime.datetime.fromisoformat(levers[i])
        coucher = datetime.datetime.fromisoformat(couchers[i])
        return "clair" if lever <= maintenant < coucher else "sombre"
    except (StopIteration, IndexError, ValueError, TypeError):
        return "clair" if 8 <= maintenant.hour < 20 else "sombre"


def dossiers_images_hub(maison):
    candidats = [maison / "Images" / "HUB", maison / "Pictures" / "HUB"]
    try:
        images = subprocess.run(["xdg-user-dir", "PICTURES"], capture_output=True, text=True, timeout=2).stdout.strip()
        if images:
            candidats.insert(0, Path(images) / "HUB")
    except (OSError, subprocess.SubprocessError):
        pass
    return [d for d in candidats if d.is_dir()]


def choisir_photo(dossiers, date):
    """Une photo de Images/HUB, qui change chaque jour mais reste la même toute la
    journée : relancer hub-theme dix fois ne doit pas changer dix fois le fond."""
    photos = sorted({f.resolve() for d in dossiers if Path(d).is_dir() for f in Path(d).iterdir()
                     if f.is_file() and f.suffix.lower() in EXTENSIONS_PHOTO})
    return photos[date.toordinal() % len(photos)] if photos else None


# ── Fond d'écran ──────────────────────────────────────────────────────────
def nappes(fond, theme, accent, largeur, hauteur, teinter=True):
    """Les nappes du menu figées à l'instant zéro de leur animation (dessinerFond)."""
    palette = PALETTES.get(fond, PALETTES["aurore"])[theme]
    resultat = []
    for i, teinte_base in enumerate(palette["nappes"]):
        x0, y0, r0, phase = NAPPES[i]
        if fond == "ocean":
            x, y = x0 + math.sin(phase) * .3, y0 + math.sin(phase) * .05
        elif fond == "braise":
            x, y = x0 + math.sin(phase) * .1, (y0 % 1.4 + 1.4) % 1.4 - .2
        else:
            x, y = x0 + math.sin(phase) * .16, y0 + math.cos(phase) * .14
        if fond == "minimal":
            y, rayon = -.3, 1.1
            alpha = .9 if theme == "clair" else .5
        else:
            rayon = r0 * (1 + math.sin(phase) * .08)
            alpha = (.6 if i == 0 else .5) if theme == "clair" else (.35 if i == 3 else .34 if i == 0 else .2)
        couleur = teinte_base
        if teinter and fond != "minimal":
            couleur = melange(teinte_base, accent, .75 if i == 0 else .25)
        resultat.append({
            "x": x * largeur, "y": y * hauteur, "r": rayon * largeur, "alpha": alpha,
            "couleur": tuple(round(c) for c in couleur),
        })
    return resultat


def fond_svg(fond, theme, accent, largeur=LARGEUR_FOND, hauteur=HAUTEUR_FOND, teinter=True):
    base = PALETTES.get(fond, PALETTES["aurore"])[theme]["base"]
    dessin = nappes(fond, theme, accent, largeur, hauteur, teinter)
    # Le menu additionne la lumière en sombre (« lighter ») ; SVG n'a pas d'addition
    # portable, « screen » en est le plus proche et librsvg le connaît.
    melange_css = ' style="mix-blend-mode:screen"' if theme == "sombre" else ""
    degrades, calques = [], []
    for i, n in enumerate(dessin):
        couleur = rvb_hex(n["couleur"])
        degrades.append(
            f'<radialGradient id="n{i}" gradientUnits="userSpaceOnUse" cx="{n["x"]:.1f}" cy="{n["y"]:.1f}" r="{n["r"]:.1f}">'
            f'<stop offset="0" stop-color="{couleur}" stop-opacity="{n["alpha"]}"/>'
            f'<stop offset="1" stop-color="{couleur}" stop-opacity="0"/></radialGradient>')
        calques.append(f'<rect width="{largeur}" height="{hauteur}" fill="url(#n{i})"{melange_css}/>')
    return (
        f'<svg xmlns="http://www.w3.org/2000/svg" width="{largeur}" height="{hauteur}" viewBox="0 0 {largeur} {hauteur}">\n'
        f'<defs>{"".join(degrades)}</defs>\n'
        f'<rect width="{largeur}" height="{hauteur}" fill="{base}"/>\n'
        f'<g style="isolation:isolate">{"".join(calques)}</g>\n</svg>\n')


# Tramage ordonné 4×4 : un dégradé très étiré sur 8 bits fait des bandes visibles sur
# une TV ; un bruit régulier d'un demi-niveau les efface sans grain perceptible.
BAYER = [[0, 8, 2, 10], [12, 4, 14, 6], [3, 11, 1, 9], [15, 7, 13, 5]]


def rendre_fond(fond, theme, accent, largeur, hauteur, teinter=True):
    """Le même dessin en pixels, sans bibliothèque : Kodi ne lit pas le SVG. Rendu exact
    du menu (addition en sombre, recouvrement en clair)."""
    base = hex_rvb(PALETTES.get(fond, PALETTES["aurore"])[theme]["base"])
    dessin = nappes(fond, theme, accent, largeur, hauteur, teinter)
    additif = theme == "sombre"
    lignes = []
    for y in range(hauteur):
        canaux = [[float(base[c])] * largeur for c in range(3)]
        for n in dessin:
            dy2 = (y + .5 - n["y"]) ** 2
            r = n["r"]
            if dy2 >= r * r:
                continue
            cx, a = n["x"], n["alpha"]
            demi = math.sqrt(r * r - dy2)
            debut, fin = max(0, int(cx - demi)), min(largeur, int(cx + demi) + 1)
            col = n["couleur"]
            for x in range(debut, fin):
                t = 1 - math.sqrt((x + .5 - cx) ** 2 + dy2) / r
                if t <= 0:
                    continue
                al = a * t
                for c in range(3):
                    if additif:
                        canaux[c][x] += col[c] * al
                    else:
                        canaux[c][x] += (col[c] - canaux[c][x]) * al
        ligne = bytearray(largeur * 3)
        bayer = BAYER[y % 4]
        for x in range(largeur):
            tramage = (bayer[x % 4] + .5) / 16
            for c in range(3):
                ligne[x * 3 + c] = max(0, min(255, int(canaux[c][x] + tramage)))
        lignes.append(ligne)
    return largeur, hauteur, lignes


def ecrire_atomique(chemin, donnees):
    """Écrire à côté puis renommer : une coupure ne laisse jamais un fichier tronqué
    à un logiciel qui le remplacerait par des valeurs vierges."""
    chemin = Path(chemin)
    chemin.parent.mkdir(parents=True, exist_ok=True)
    provisoire = chemin.with_name(chemin.name + ".hub-tmp")
    if isinstance(donnees, str):
        donnees = donnees.encode("utf-8")
    provisoire.write_bytes(donnees)
    os.replace(provisoire, chemin)


def ecrire_png(chemin, largeur, hauteur, lignes):
    canaux = len(lignes[0]) // largeur
    brut = b"".join(b"\x00" + bytes(l) for l in lignes)

    def bloc(genre, corps):
        return struct.pack(">I", len(corps)) + genre + corps + struct.pack(">I", zlib.crc32(genre + corps) & 0xFFFFFFFF)
    png = (b"\x89PNG\r\n\x1a\n"
           + bloc(b"IHDR", struct.pack(">IIBBBBB", largeur, hauteur, 8, 6 if canaux == 4 else 2, 0, 0, 0))
           + bloc(b"IDAT", zlib.compress(brut, 9)) + bloc(b"IEND", b""))
    ecrire_atomique(chemin, png)


def empreinte(*elements):
    return hashlib.sha256(json.dumps([VERSION_RENDU, *elements], default=str).encode()).hexdigest()[:10]


def generer_fond_svg(dossier, fond, theme, accent, teinter=True, nettoyer=True):
    """Le nom porte l'empreinte du contenu : GNOME ne recharge pas une image dont
    l'adresse n'a pas changé, et un nom stable rend l'écriture idempotente."""
    dossier = Path(dossier)
    svg = fond_svg(fond, theme, accent, teinter=teinter)
    chemin = dossier / f"hub-{fond}-{theme}-{hashlib.sha256(svg.encode()).hexdigest()[:10]}.svg"
    if not chemin.exists() or chemin.read_text(encoding="utf-8") != svg:
        ecrire_atomique(chemin, svg)
    if nettoyer:
        for ancien in dossier.glob("hub-*.svg"):
            if ancien != chemin:
                ancien.unlink(missing_ok=True)
    return chemin


def construire_apparence(profil, theme, c, date=None, generer=True, dossier_fonds=None):
