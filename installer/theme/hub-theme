def generer_plymouth(dossier, apparence):
    """Plymouth s'affiche avant toute session : il ne suit pas le profil en direct. Le
    thème prend les couleurs du profil au moment où l'installateur le génère ; toujours
    sombre, parce qu'un écran blanc au démarrage éblouit dans un salon le soir."""
    dossier = Path(dossier)
