# AirPlay (son) du HUB (shairport-sync) — unité UTILISATEUR.
#
# Le paquet Ubuntu livre un service SYSTÈME qui sort en ALSA direct : l'installateur
# le masque, sinon il prendrait la carte son à PipeWire, à Kodi et au menu. Celui-ci
# sort par PipeWire (couche PulseAudio) et publie ses métadonnées dans un tube que
# hub-enceinte lit. Sa configuration est regénérée à chaque démarrage (nom du menu).

[Unit]
Description=HUB : AirPlay, réception du son (shairport-sync)
Documentation=file:///usr/local/lib/hub/enceinte/README.md
PartOf=graphical-session.target
Wants=hub-enceinte.service
After=graphical-session.target hub-enceinte.service pipewire-pulse.service

[Service]
Type=simple
ExecCondition=/usr/local/bin/hub-enceinte actif airplay
ExecStart=/usr/local/bin/hub-enceinte lancer airplay
ExecStopPost=/usr/local/bin/hub-enceinte evenement airplay arret
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
UMask=0077
# Bac à sable : pourquoi chaque ligne, et ce qui reste à vérifier sur le M720q, dans
# hub-enceinte.service et le README (« Bac à sable »).
# /run/user/UID/hub est partagé avec le menu, la voix, la télécommande : créé ici sans
# bac à sable (+), jamais par RuntimeDirectory=, qui le supprimerait à l'arrêt.
ExecStartPre=+/usr/bin/mkdir -p -m 0700 %t/hub
PrivateTmp=yes
ProtectHome=tmpfs
# La session : PipeWire, Wayland, D-Bus, systemctl --user (sockets, que la lecture seule
# n'empêche pas de joindre) ; les réglages du menu, lus.
BindReadOnlyPaths=%t -%h/.config/hub
BindPaths=-%t/hub
# L'autorité TLS et les jetons des téléphones de la télécommande : de quoi piloter le HUB.
# Et le code de la recopie d'écran, qui ne regarde qu'UxPlay.
InaccessiblePaths=-%h/.config/hub/telecommande-tls -%h/.config/hub/telecommande-jetons.json -%h/.config/hub/enceinte
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
MemoryMax=200M

[Install]
WantedBy=graphical-session.target
