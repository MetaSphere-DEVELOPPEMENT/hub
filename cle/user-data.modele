#cloud-config
# ═══════════════════════════════════════════════════════════════════════════════
#  Clé HUB — installation automatique d'Ubuntu 26.04 sur le M720q
# ═══════════════════════════════════════════════════════════════════════════════
#
# Même recette que vm/autoinstall/user-data, éprouvée en VM, avec trois différences :
#  - le disque visé est désigné explicitement : le NVMe interne, jamais un disque USB
#    (le disque de travail (marque masquée), plus gros, serait choisi par « le plus grand ») ;
#  - la machine S'ÉTEINT à la fin : on retire la clé avant de la rallumer ;
#  - le projet HUB est copié depuis la clé et installé au premier démarrage.
# Les valeurs @…@ sont remplies par construire-cle.sh.
autoinstall:
  version: 1
  interactive-sections: []

  locale: fr_FR.UTF-8
  keyboard:
    layout: fr
  timezone: Europe/Paris

  identity:
    hostname: hub
    realname: Samuel Boudine
    username: samuel
    password: "@MOT_DE_PASSE_HACHE@"

  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - "@CLE_SSH@"

  # Pas de chiffrement : le HUB démarre sans clavier.
  storage:
    layout:
      name: direct
      match:
        path: "@DISQUE@"

  # Seulement des paquets du pool de l'ISO. Sans réseau, l'installateur n'a que lui, et
  # un seul paquet absent l'arrête AVANT late-commands : Ubuntu nue, sans /opt/hub ni
  # premier démarrage. Vu sur le M720q le 16/09/2026, câble débranché, avec git ici.
  # git viendra de hub-installer.sh (étape 9), une fois le réseau là.
  # Liste du pool : cle/paquets-iso-ubuntu-26.04.1.txt, vérifiée par tests/test_cle_hors_ligne.py.
  packages:
    - openssh-server

  late-commands:
    - mkdir -p /target/opt/hub
    - cp -a /cdrom/hub/. /target/opt/hub/
    - cp /target/opt/hub/cle/hub-premier-demarrage.service /target/etc/systemd/system/
    - curtin in-target --target=/target -- systemctl enable ssh hub-premier-demarrage.service

  shutdown: poweroff
